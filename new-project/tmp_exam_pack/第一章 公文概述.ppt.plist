    kMDItemTextContent = "\U516c\U6587\U5199\U4f5c\U4e0e\U5904\U7406\n\U516c\U5171\U7ba1\U7406\U5b66\U9662\n\U738b\U950b  \U535a\U58eb\n \n \U5b66\U4e60\U548c\U8003\U6838\Uff1a\n1\U3001\U6210\U7ee9\U6784\U6210\Uff1a\U5e73\U65f6\U6210\U7ee9\Uff0840%\Uff09+\U671f\U672b\U5f00\U5377\U8003\U8bd5\Uff0860%\Uff09\n    \U5e73\U65f6\U6210\U7ee9\Uff1a\U8003\U52e4\U3001\U8bfe\U5802\U8ba8\U8bba\U3001\U5b9e\U8bad\U4f5c\U4e1a\n    \U671f\U672b\U8bd5\U5377\Uff1a\U4e3b\U89c2\U5199\U4f5c\U9898\Uff1a60\U5206\Uff0c\U5ba2\U89c2\U9898\Uff1a40\U5206\n2\U3001\U5b66\U4e60\U8fc7\U7a0b\Uff1a\n      \U5206\U7ec4\Uff1a4-5\U4eba\U4e00\U7ec4\Uff0c\U4e0a\U53f0\U53d1\U8a00\Uff08+5\U5206\Uff09\n      \U8d44\U6599\Uff1a\U7b14\U8bb0\U672c\Uff08\U7eb8\U8d28\Uff09+\U7b14\n      \U7f51\U7ad9\Uff1a\U56fd\U5bb6\U536b\U5065\U59d4+\U56fd\U5bb6\U533b\U4fdd\U5c40+\U56fd\U5bb6CDC\n3\U3001\U5982\U4f55\U6b63\U786e\U4f7f\U7528AI\n \U7b2c\U4e00\U7ae0 \U516c\U6587\U6982\U8ff0\n\U7b2c\U4e00\U8282 \U516c\U6587\U7684\U5b9a\U4e49\U4e0e\U7279\U70b9\n    \U4e00\U3001\U516c\U6587\U7684\U5b9a\U4e49\n1.\U516c\U6587\Uff0c\U662f\U968f\U7740\U6587\U5b57\U3001\U9636\U7ea7\U3001\U56fd\U5bb6\U7684\U4ea7\U751f\U800c\U4ea7\U751f\U3002\n\U826f\U6e1a\U6587\U660e\n2.\U516c\U6587\Uff0c\n\U662f\U529e\U7406\U516c\U52a1\U7684\U6587\U4e66\Uff0c\n\U516c\U6587\U7684\U53d1\U6587\U4e3b\U4f53\U662f\U515a\U653f\U673a\U5173\U3001\U793e\U4f1a\U56e2\U4f53\U548c\U4f01\U4e8b\U4e1a\U5355\U4f4d\U5728\U884c\U4f7f\U7ba1\U7406\U804c\U6743\U3001\U5904\U7406\U65e5\U5e38\U5de5\U4f5c\U65f6\U4f7f\U7528\U7684\U4e66\U9762\U6587\U5b57\U5de5\U5177\Uff0c\n\U662f\U5404\U7c7b\U793e\U4f1a\U7ec4\U7ec7\U7528\U4ee5\U8868\U8fbe\U610f\U5fd7\U3001\U4f20\U8fbe\U6307\U4ee4\U7684\U65b9\U5f0f\U548c\U624b\U6bb5\U3002\n\U5224\U65ad\Uff1a\n1.\U516c\U6587\U7684\U53d1\U6587\U4e3b\U4f53\U662f\U515a\U653f\U673a\U5173\U3001\U793e\U4f1a\U56e2\U4f53\U548c\U4f01\U4e8b\U4e1a\U5355\U4f4d\n2.\U516c\U6587\U662f\U5404\U7c7b\U793e\U4f1a\U7ec4\U7ec7\U7528\U4ee5\U8868\U8fbe\U610f\U5fd7\U3001\U4f20\U8fbe\U6307\U4ee4\U7684\U65b9\U5f0f\U548c\U624b\U6bb5\U3002\n\U591a\U9009\Uff1a\U516c\U6587\U4ea7\U751f\U7684\U6761\U4ef6\U6709\Uff08\Uff09\nA\U6587\U5b57\U7684\U4ea7\U751f  B.\U9636\U7ea7\U7684\U4ea7\U751f   \nC.\U56fd\U5bb6\U7684\U4ea7\U751f  D.\U4eba\U7c7b\U7684\U4ea7\U751f\n3.\U515a\U653f\U673a\U5173\U516c\U6587\U662f\U515a\U653f\U673a\U5173\U5b9e\U65bd\U9886\U5bfc\U3001\U5c65\U884c\U804c\U80fd\U3001\U5904\U7406\U516c\U52a1\U7684\U5177\U6709\U7279\U5b9a\U6548\U529b\U548c\U89c4\U8303\U4f53\U5f0f\U7684\U6587\U4e66\Uff0c\U662f\U4f20\U8fbe\U8d2f\U5f7b\U515a\U548c\U56fd\U5bb6\U65b9\U9488\U653f\U7b56\Uff0c\U516c\U5e03\U6cd5\U89c4\U548c\U89c4\U7ae0\Uff0c\U6307\U5bfc\U3001\U5e03\U7f6e\U548c\U5546\U6d3d\U5de5\U4f5c\Uff0c\U8bf7\U793a\U548c\U7b54\U590d\U95ee\U9898\Uff0c\U62a5\U544a\U3001\U901a\U62a5\U548c\U4ea4\U6d41\U60c5\U51b5\U7b49\U7684\U91cd\U8981\U5de5\U5177\U3002\n  \U4e8c\U3001\U516c\U6587\U7684\U4e94\U4e2a\U7279\U70b9\Uff1a\n1.\U4f5c\U8005\U6cd5\U5b9a\U6027\n2.\U4f5c\U7528\U6743\U5a01\U6027\n3.\U6548\U7528\U73b0\U5b9e\U6027\n4.\U4f53\U5f0f\U89c4\U8303\U6027\n5.\U5904\U7406\U7a0b\U5e8f\U6027\n     \n1\Uff0e\U4f5c\U8005\U7684\U6cd5\U5b9a\U6027\n\U516c\U6587\U5fc5\U987b\U662f\U7531\U6cd5\U5b9a\U4f5c\U8005\U5236\U6210\U548c\U53d1\U5e03\U7684\U3002\U6cd5\U5b9a\U4f5c\U8005\U662f\U6307\U4f9d\U6cd5\U6210\U7acb\U5e76\U80fd\U4ee5\U81ea\U5df1\U7684\U540d\U4e49\U884c\U4f7f\U6743\U5229\U548c\U627f\U62c5\U4e49\U52a1\U7684\U793e\U4f1a\U7ec4\U7ec7\U53ca\U5176\U9886\U5bfc\U4eba\U3002\n\U6ce8\U610f\Uff1a\U4ece\U4e8b\U516c\U6587\U64b0\U5199\U7684\U4eba\U5458\n2\Uff0e\U516c\U6587\U6548\U7528\U7684\U73b0\U5b9e\U6027\n    \U516c\U6587\U7684\U73b0\U5b9e\U6548\U7528\Uff0c\U4e00\U662f\U6307\U516c\U6587\U4e3b\U8981\U5728\U73b0\U884c\U5de5\U4f5c\U4e2d\U4f7f\U7528\Uff0c\U4e8c\U662f\U6307\U516c\U6587\U7684\U73b0\U5b9e\U6548\U7528\U6709\U4e00\U5b9a\U7684\U65f6\U95f4\U6027\Uff08\U65f6\U6548\U671f\Uff09\U3002\n3\Uff0e\U516c\U6587\U4f5c\U7528\U7684\U6743\U5a01\U6027\n\U516c\U6587\U7684\U6743\U5a