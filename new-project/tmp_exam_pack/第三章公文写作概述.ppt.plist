    kMDItemTextContent = "\U7b2c\U4e09\U7ae0 \U516c\U6587\U5199\U4f5c\U6982\U8ff0\n\U7b2c\U4e00\U8282  \U516c\U6587\U5199\U4f5c\U7684\U7279\U70b9\n1.\U88ab\U52a8\U5199\U4f5c\Uff0c\U9075\U547d\U6027\U5f3a\Uff08\U53d1\U6587\U673a\U5173\U548c\U8d1f\U8d23\U4eba\Uff09\n2.\U5bf9\U8c61\U660e\U786e\Uff0c\U9488\U5bf9\U6027\U5f3a\Uff08\U4e3b\U9001\U673a\U5173\U548c\U6284\U9001\U673a\U5173\Uff09\n3.\U51b3\U7b56\U4e4b\U4f5c\Uff0c\U653f\U7b56\U6027\U5f3a\Uff08\U7b26\U5408\U515a\U653f\U65b9\U9488\Uff09\n4.\U6025\U8feb\U4e4b\U4f5c\Uff0c\U65f6\U9650\U6027\U5f3a\Uff08\U8f7b\U91cd\U7f13\U6025\Uff09\n5.\U96c6\U601d\U5e7f\U76ca\Uff0c\U7fa4\U4f53\U6027\U5f3a\n6.\U8bb2\U7a76\U683c\U5f0f\Uff0c\U89c4\U8303\U6027\U5f3a\n \n\U7b2c\U4e8c\U8282 \U516c\U6587\U7684\U8d77\U8349\U8005\n \U4e00\U3001\U516c\U6587\U8d77\U8349\U8005\U5e94\U5177\U5907\U7684\U57fa\U672c\U7d20\U8d28\n1\Uff0e\U7406\U8bba\U7d20\U8d28\U3002\Uff08\U9a6c\U514b\U601d\U7406\U8bba\U3001\U65b9\U9488\U653f\U7b56\Uff09\n2\Uff0e\U77e5\U8bc6\U7d20\U8d28\U3002\Uff08\U4e1a\U52a1\U77e5\U8bc6\U3001\U884c\U4e1a\U77e5\U8bc6\Uff09\n3.   \U54c1\U5fb7\U7d20\U8d28\U3002\n\U4e8c\U3001\U516c\U6587\U8d77\U8349\U8005\U5e94\U5177\U5907\U7684\U57fa\U672c\U80fd\U529b\n1\Uff0e\U8c03\U67e5\U5206\U6790\U80fd\U529b\U3002\Uff08\U53d1\U73b0\U95ee\U9898\U3001\U5206\U6790\U95ee\U9898\Uff09\n2\Uff0e\U4fe1\U606f\U5904\U7406\U80fd\U529b\U3002\n3\Uff0e\U6587\U5b57\U8868\U8fbe\U80fd\U529b\U3002\Uff08\U719f\U80fd\U751f\U5de7\Uff09\n4\Uff0e\U628a\U63e1\U8bfb\U8005\U5fc3\U7406\U7684\U80fd\U529b\U3002\Uff08\U8bfb\U8005\U610f\U8bc6\Uff09\n5.\U51c6\U786e\U628a\U63e1\U9886\U5bfc\U4eba\U771f\U5b9e\U610f\U56fe\U7684\U80fd\U529b\U3002\n\U7b2c\U4e09\U8282 \U516c\U6587\U7684\U4e3b\U9898\n\U4e00\U3001\U4e3b\U9898\U7684\U542b\U4e49\n\U516c\U6587\U7684\U4e3b\U9898\U662f\U6307\U6587\U7ae0\U6240\U8868\U8fbe\U7684\U4e2d\U5fc3\U601d\U60f3\U6216\U57fa\U672c\U89c2\U70b9\U3002\U6bcf\U7bc7\U516c\U6587\U90fd\U6709\U660e\U786e\U7684\U884c\U6587\U76ee\U7684\U548c\U57fa\U672c\U89c2\U70b9\U