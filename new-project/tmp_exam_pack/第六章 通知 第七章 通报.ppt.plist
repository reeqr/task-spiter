    kMDItemTextContent = "\U4e00\U3001\U901a\U77e5\U7684\U9002\U7528\U8303\U56f4\n      \U901a\U77e5\U9002\U7528\U4e8e\U53d1\U5e03\U3001\U4f20\U8fbe\U8981\U6c42\U4e0b\U7ea7\U673a\U5173\U6267\U884c\U548c\U6709\U5173\U5355\U4f4d\U5468\U77e5\U6216\U8005\U6267\U884c\U7684\U4e8b\U9879\Uff0c\U4ee5\U53ca\U6279\U8f6c\U3001\U8f6c\U53d1\U516c\U6587\U3002\Uff08\U4f7f\U7528\U9891\U7387\U6700\U9ad8\Uff09\n\Uff08\U4e00\Uff09\U4f7f\U7528\U8303\U56f4\U7684\U5e7f\U6cdb\U6027      \Uff08\U56db\Uff09\U529f\U80fd\U7684\U591a\U6837\U6027\n\Uff08\U4e8c\Uff09\U4e00\U5b9a\U7684\U6307\U5bfc\U6027          \Uff08\U4e94\Uff09\U5185\U5bb9\U7684\U5355\U4e00\U6027\n\Uff08\U4e09\Uff09\U4e25\U683c\U7684\U6267\U884c\U6027\n\U4e09\U3001\U901a\U77e5\U7684\U79cd\U7c7b\n      \U6309\U7167\U901a\U77e5\U7684\U5185\U5bb9\U548c\U7528\U9014\U7684\U4e0d\U540c\Uff0c\U53ef\U4ee5\U5c06\U5176\U5206\U6210\U6307\U793a\U6027\U901a\U77e5\U3001\U53d1\U5e03\U6027\U901a\U77e5\U3001\U8f6c\U53d1\U6027\U901a\U77e5\U3001\U6279\U8f6c\U6027\U901a\U77e5\U3001\U4e8b\U52a1\U6027\U901a\U77e5\Uff08\U5177\U4f53\U4e8b\U52a1\U6216\U529e\U7406\U4e34\U65f6\U6027\U5de5\U4f5c\Uff09\U3001\U5468\U77e5\U6027\U901a\U77e5\Uff08\U4e0d\U5177\U6709\U5f3a\U5236\U6027\Uff09\U3001\U4efb\U514d\U6027\U901a\U77e5\U3001\U4f1a\U8bae\U901a\U77e5\U7b49\U516b\U7c7b\U3002\n\U56db\U3001\U901a\U77e5\U7684\U5199\U6cd5\n  \Uff08\U4e00\Uff09\U6807\U9898 \n      \U901a\U77e5\U7684\U6807\U9898\U4e00\U822c\U91c7\U7528\U5b8c\U5168\U5f0f\U6807\U9898\U3002\n      \U53d1\U5e03\U6027\U901a\U77e5\U3001\U8f6c\U53d1\U6027\U901a\U77e5\U3001\U6279\U8f6c\U6027\U901a\U77e5\U6807\U9898\U7684\U4e8b\U7531\U90e8\U5206\U8981\U5b8c\U6574\U5f15\U7528\U88ab\U53d1\U5e03\U3001\U8f6c\U53d1\U6216\U6279\U8f6c\U7684\U6587\U4ef6\U540d\U79f0\Uff0c\U524d\U9762\U6807\U660e\U201c\U5370\U53d1\U201d\U3001\U201c\U8f6c\U53d1\U201d\U6216\U201c\U6279\U8f6c\U201d\U7684\U5b57\U6837\U3002\n      \U7d27\U6025\U60c5\U51b5\Uff1a\U201c\U7d27\U6025\U201d\U4e8c\U5b57\n      \n      \U8f6c\U53d1\U6027\U901a\U77e5\U7684\U6807\U9898\U4e24\U79cd\U7279\U6b8a\U60c5\U51b5\Uff1a\U4e00\U662f\U88ab\U8f6c\U53d1\U7684\U6587\U4ef6\U672c\U8eab\U4e5f\U662f\U4e00\U4e2a\U901a\U77e5\Uff0c\U4e8c\U662f\U5c42\U5c42\U8f6c\U53d1\U6709\U5173\U6587\U4ef6\U7684\U901a\U77e5\U3002\n      \U4f1a\U8bae\U6027\U901a\U77e5\U6807\U9898\U4e2d\U7684\U4e8b\U7531\U90e8\U5206\U7531\U4f1a\U8bae\U540d\U79f0\U4ee3\U66ff\U3002\n      \U4efb\U514d\U6027\U901a\U77e5\U6807\U9898\U4e2d\U7684\U4e8b\U7531\U90e8\U5206\U7531\U4efb\U514d\U4eba\U5458\U59d3\U540d\U52a0\U201c\U4efb\U804c\U201d\U6216\U201c\U514d\U804c\U201d\U5b57\U6837\U7ec4\U6210\U3002\n \Uff08\U4e09\Uff09\U6b63\U6587\n      1.\U6307\U793a\U6027\U901a\U77e5  \n      \U6b63\U6587\U90e8\U5206\U901a\U5e38\U7531\U901a\U77e5\U7f18\U7531\U3001\U901a\U77e5\U4e8b\U9879\U4e24\U90e8\U5206\U7ec4\U6210\U3002\n      \U901a\U77e5\U7f18\U7531\U90e8\U5206\U4ea4\U4ee3\U53d1\U6587\U7684\U539f\U56e0\U3001\U80cc\U666f\U548c\U4f9d\U636e\U3002\n      \U901a\U77e5\U4e8b\U9879\U90e8\U5206\U5185\U5bb9\U662f\U6307\U793a\U6027\U901a\U77e5\U6b63\U6587\U7684\U6838\U5fc3\U5185\U5bb9\Uff0c\U5e94\U5199\U660e\U5177\U4f53\U5de5\U4f5c\U7684\U539f\U5219\U3001\U65b9\U9488\U3001\U65b9\U6cd5\U3001\U63aa\U65bd\U3001\U8981\U6c42\U548c\U6b65\U9aa4\U7b49\U3002\n \Uff08\U4e8c\Uff09\U4e3b\U9001\U673a\U5173\n      \U901a\U77e5\U7684\U4e3b\U9001\U673a\U5173\U8f83\U591a\Uff0c\U5728\U5199\U4f5c\U65f6\U7528\U6cdb\U79f0\U8868\U793a\Uff0c\U4e3b\U9001\U673a\U5173\U7684\U5206\U7c7b\U548c\U6392\U5217\U987a\U5e8f\U5e94\U89c4\U8303\U3002\n      2.\U53d1\U5e03\U6027\U901a\U77e5\U3001\U8f6c\U53d1\U6027\U901a\U77e5\n      \U7b80\U5199\U5f0f\U7ed3\U6784\U4e0a\U5206\U4e3a\U5370\U53d1\U6216\U8f6c\U53d1\U5bf9\U8c61\Uff1b\U5370\U53d1\U6216\U8f6c\U53d1\U4f9d\U636e\Uff1b\U5370\U53d1\U6216\U8f6c\U53d1\U51b3\U5b9a\Uff1b\U6267\U884c\U8981\U6c42\U56db\U90e8\U5206\U3002\n      \U8be6\U5199\U5f0f\U7684\U6b63\U6587\U90e8\U5206\U9664\U9610\U8ff0\U4e0a\U8ff0\U5185\U5bb9\U5916\Uff0c\U8fd8\U9488\U5bf9\U6240\U5370\U53d1\U6216\U8f6c\U5